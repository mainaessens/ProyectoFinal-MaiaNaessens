# Copiar este archivo a .claude/.env y completar los valores (sin comillas).
# .claude/.env está ignorado por git (ver .gitignore) — NUNCA se versiona.
# El código lo carga solo (lib/cargar-env.mjs) y es la ÚNICA fuente de estas
# variables: salen de acá, no del entorno del sistema.

# Imágenes IA (Glif)
GLIF_API_TOKEN=

# Conector de Instagram (Graph API de Meta)
INSTAGRAM_ACCESS_TOKEN=

# Alojamiento de imágenes públicas (Meta las descarga por URL) — Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Google Drive (descargar-assets.ps1): scope drive.readonly.
# Opción rápida (dura ~1 h): pegar un access token.
GOOGLE_ACCESS_TOKEN=
# Opción estable: el script renueva el token solo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
