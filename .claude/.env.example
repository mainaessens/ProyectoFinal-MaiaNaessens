# Copiar a variables de entorno del sistema (NUNCA a un archivo .env versionado)
# Fase 1 — Publicación (Late / Postiz)
LATE_API_KEY=

# Fase 6 — Imágenes IA (Glif)
GLIF_API_TOKEN=

# Fase 7-8 — Meta Ads (vía Pipeboard)
PIPEBOARD_API_TOKEN=

# Fase 2-3 — Google Workspace (Drive, Calendar) usa OAuth propio, no requiere key aquí
# Fase 3 — Jira usa OAuth 2.1 con el MCP oficial de Atlassian, no requiere key aquí
# Fase 5 — Canva usa OAuth, no requiere key aquí

# Fase 1 — Conector propio de Instagram (Graph API de Meta)
INSTAGRAM_ACCESS_TOKEN=
# Opcional, un token por cliente: INSTAGRAM_TOKEN_<CLIENTE> (ej. INSTAGRAM_TOKEN_LUMBRE_PILATES)
SUPABASE_URL=
SUPABASE_KEY=
