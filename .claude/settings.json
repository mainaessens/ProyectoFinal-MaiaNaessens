{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./agencia/**)",
      "Write(./agencia/clientes/**)",
      "Write(./agencia/.claude/**)"
    ],
    "deny": [],
    "ask": []
  },
  "env": {
    "GLIF_API_TOKEN": "${GLIF_API_TOKEN}",
    "PIPEBOARD_API_TOKEN": "${PIPEBOARD_API_TOKEN}",
    "LATE_API_KEY": "${LATE_API_KEY}"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__postiz__.*|mcp__meta-ads__create.*|mcp__meta-ads__update.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File .claude/hooks/validar-publicacion.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__postiz__.*|mcp__meta-ads__.*|mcp__atlassian__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File .claude/hooks/registrar-actividad.ps1"
          }
        ]
      }
    ]
  }
}
