{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./agencia/**)",
      "Write(./agencia/clientes/**)",
      "Write(./agencia/.claude/**)"
    ],
    "deny": [],
    "ask": []
  },
  "env": {
    "GLIF_API_TOKEN": "${GLIF_API_TOKEN}"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__instagram__(publicar|subir).*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/validar-publicacion.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__instagram__.*|mcp__gworkspace__.*_event",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/registrar-actividad.ps1\""
          }
        ]
      }
    ]
  }
}
